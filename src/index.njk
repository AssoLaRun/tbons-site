---
layout: base.njk
permalink: /
---
{%- from "partials/macros.njk" import photo -%}
{%- set h = accueil.hero -%}

<section class="hero conteneur">
  <div class="hero__texte">
    <span class="pastille">{{ h.etiquette }}</span>
    <h1>{{ h.titre_ligne1 }}<br>{{ h.titre_ligne2 }} <span class="accent">{{ h.titre_accent }}</span></h1>
    <p class="hero__chapo">{{ h.texte }}</p>
    <div class="boutons">
      <a class="bouton bouton--primaire" href="/actions/">Découvrir nos actions</a>
      <a class="bouton bouton--contour" href="#lyceen">Tu es lycéen ? →</a>
    </div>
  </div>
  <div class="hero__visuel">
    {{ photo(h.photo, h.photo_alt, "Photo : les ambassadeurs ARIL, Grande Finale", "hero__photo") }}
    {% if h.encart_titre %}
    <div class="hero__encart">
      <span class="surtitre surtitre--clair">{{ h.encart_titre }}</span>
      <span class="hero__encart-texte">{{ h.encart_texte }}</span>
    </div>
    {% endif %}
  </div>
</section>

<section class="bloc bloc--blanc" id="qui">
  <div class="conteneur qui">
    <div class="qui__titre">
      <span class="surtitre">Qui sommes-nous ?</span>
      <h2>{{ accueil.qui.titre }}</h2>
    </div>
    <div class="qui__corps">
      <p class="grand-texte">{{ accueil.qui.texte }}</p>
      <div class="chiffres">
        {% for c in accueil.chiffres %}
        <div class="chiffre"><span class="chiffre__valeur">{{ c.valeur }}</span><span class="chiffre__libelle">{{ c.libelle }}</span></div>
        {% endfor %}
      </div>
      <div class="liens-fleches">
        <a href="/qui-sommes-nous/">Notre histoire →</a>
        <a href="/qui-sommes-nous/#le-bureau">Le bureau →</a>
        <a href="#partenaires">Nos partenaires →</a>
      </div>
    </div>
  </div>
</section>

<section class="bloc">
  <div class="conteneur">
    <h2 class="titre-section">{{ accueil.mission_titre }}</h2>
    <div class="grille grille--3">
      {% for m in accueil.mission %}
      <div class="carte carte--pilier {% if loop.first %}carte--sombre{% endif %}">
        <span class="carte__numero">{{ "0" + loop.index }}</span>
        <h3>{{ m.titre }}</h3>
        <p>{{ m.texte }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="bloc bloc--blanc" id="actions">
  <div class="conteneur">
    <span class="surtitre">Nos actions</span>
    <h2 class="titre-section">Ce que nous faisons, concrètement</h2>
    <div class="grille grille--3 actions">
      {% for a in collections.actions %}
        {% if a.data.phare %}
        <a class="action-phare" href="{{ a.url }}">
          <div class="action-phare__texte">
            <span class="badge">Projet phare</span>
            <h3>{{ a.data.titre }}</h3>
            <p>{{ a.data.resume }}</p>
            <span class="lien-clair">Découvrir →</span>
          </div>
          {{ photo(a.data.image, a.data.image_alt, "Photo à ajouter", "action-phare__photo") }}
        </a>
        {% else %}
        <a class="carte carte--action" href="{{ a.url }}">
          {{ photo(a.data.image, a.data.image_alt, "Visuel à ajouter", "carte__photo") }}
          <div class="carte--action__texte">
            <h3>{{ a.data.titre }}</h3>
            <p>{{ a.data.resume }}</p>
            <span class="lien">En savoir plus →</span>
          </div>
        </a>
        {% endif %}
      {% endfor %}
      <div class="carte carte--pointilles">
        <h3>Une idée d'action ?</h3>
        <p>Établissement, collectivité ou association, construisons un projet ensemble.</p>
        <a class="lien" href="/contact/">Nous écrire →</a>
      </div>
    </div>
  </div>
</section>

<section class="bloc bloc--teal" id="lyceen">
  <div class="conteneur lyceen">
    <div class="lyceen__texte">
      <span class="surtitre surtitre--clair">Espace lycéen</span>
      <h2 class="titre-geant">{{ accueil.lyceen.titre }}</h2>
      <p class="grand-texte">{{ accueil.lyceen.texte }}</p>
      <div class="boutons">
        <a class="bouton bouton--creme" href="/espace-lyceen/">Découvre l'espace lycéen</a>
        {% if accueil.lyceen.lien_candidature %}<a class="bouton bouton--contour-clair" href="{{ accueil.lyceen.lien_candidature }}">{{ accueil.lyceen.bouton_candidature }}</a>{% endif %}
      </div>
    </div>
    <div class="tuiles">
      {% for t in accueil.lyceen.tuiles %}
      <a class="tuile {% if t.mise_en_avant %}tuile--accent{% endif %}" href="{{ t.lien or '/espace-lyceen/' }}">
        <span class="tuile__titre">{{ t.titre }}</span>
        <span class="tuile__texte">{{ t.texte }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="bloc" id="partenaires">
  <div class="conteneur">
    <div class="entete-section">
      <h2 class="titre-section">{{ partenaires.titre }}</h2>
      <p>{{ partenaires.texte }}</p>
    </div>
    <div class="logos">
      {% for p in partenaires.partenaires %}
      {% if p.lien %}<a class="logo" href="{{ p.lien }}">{% else %}<div class="logo">{% endif %}
        {% if p.logo %}<img src="{{ p.logo }}" alt="{{ p.nom }}" loading="lazy">{% else %}<span>{{ p.nom }}</span>{% endif %}
      {% if p.lien %}</a>{% else %}</div>{% endif %}
      {% endfor %}
    </div>
    {% if partenaires.lycees.length %}
    <p class="petit-titre">{{ partenaires.lycees_titre }}</p>
    <ul class="pastilles">
      {% for l in partenaires.lycees %}<li>{{ l }}</li>{% endfor %}
    </ul>
    {% endif %}
  </div>
</section>

<section class="bloc bloc--blanc" id="actus">
  <div class="conteneur">
    <div class="entete-section">
      <div>
        <span class="surtitre">Restez informé</span>
        <h2 class="titre-section">Actualités et presse</h2>
      </div>
      <a class="lien" href="/actualites/">Toutes les actualités →</a>
    </div>
    <div class="grille grille--3 actus">
      {% for n in collections.actualites | limit(3) %}
      <a class="actu" href="{{ n.data.lien_externe or n.url }}">
        {{ photo(n.data.image, n.data.image_alt, "Photo", "actu__photo") }}
        <span class="actu__meta">{{ n.data.categorie }} · {{ n.date | dateFr }}</span>
        <h3>{{ n.data.titre }}</h3>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="bloc" id="soutenir">
  <div class="conteneur">
    <div class="soutenir">
      <div class="soutenir__texte">
        <h2>{{ accueil.soutenir.titre }}</h2>
        <p>{{ accueil.soutenir.texte }}</p>
      </div>
      <div class="soutenir__liens">
        <a class="ligne-bouton ligne-bouton--accent" href="{{ site.lien_don or '/nous-soutenir/' }}"><span>Faire un don</span><span aria-hidden="true">→</span></a>
        <a class="ligne-bouton" href="{{ site.lien_adhesion or '/nous-soutenir/#adherer' }}"><span>Adhérer à l'association</span><span aria-hidden="true">→</span></a>
        <a class="ligne-bouton" href="/nous-soutenir/#devenir-partenaire"><span>Devenir partenaire</span><span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>
