{%- set lang = lang or "fr" -%}
{%- set t = ui[lang] -%}
<!doctype html>
<html lang="{{ t.code_html }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if titre and page.url != "/" and page.url != "/rc/" %}{{ titre }} · {% endif %}{{ site.nom }}</title>
  <meta name="description" content="{{ resume or chapo or t.description }}">
  <meta property="og:title" content="{{ titre or site.nom }}">
  <meta property="og:description" content="{{ resume or chapo or t.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.nom }}">
  <meta property="og:locale" content="{{ 'fr_FR' if lang == 'fr' else 'fr_RE' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {%- if image and image.startsWith("/") %}
  <meta property="og:image" content="{{ site.url }}{{ image }}">
  {%- else %}
  <meta property="og:image" content="{{ site.url }}/assets/img/partage.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="To Be or Not Subir, la force d'exister, sans subir.">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#087B5D">
  {% if page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "NGO",
    "name": {{ site.nom | dump | safe }},
    "alternateName": "TBONS",
    "url": {{ site.url | dump | safe }},
    "logo": {{ (site.url + "/icon-512.png") | dump | safe }},
    "description": {{ site.description | dump | safe }},
    "foundingDate": "2023",
    "email": {{ site.email | dump | safe }},
    "address": { "@type": "PostalAddress", "streetAddress": "22 route de Moufia", "postalCode": "97490", "addressLocality": "Saint-Denis", "addressRegion": "La Réunion", "addressCountry": "FR" },
    "sameAs": [{% set sep = joiner(",") %}{% for l in [site.instagram, site.facebook, site.linkedin] %}{% if l %}{{ sep() }}{{ l | dump | safe }}{% endif %}{% endfor %}]
  }
  </script>
  {% endif %}
  <link rel="alternate" hreflang="{{ 'rcf' if lang == 'fr' else 'fr' }}" href="{{ page.url | autreLangue(lang, collections.all) }}">
  <link rel="preload" href="/assets/fonts/public-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css">
  <script src="/assets/js/menu.js" defer></script>
</head>
<body>
<a class="skip" href="#contenu">{{ t.aller_contenu }}</a>
{% include "partials/header.njk" %}
<main id="contenu">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
</body>
</html>
