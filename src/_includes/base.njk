<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if titre and page.url != "/" %}{{ titre }} · {% endif %}{{ site.nom }}</title>
  <meta name="description" content="{{ resume or chapo or site.description }}">
  <meta property="og:title" content="{{ titre or site.nom }}">
  <meta property="og:description" content="{{ resume or chapo or site.description }}">
  {% if image %}<meta property="og:image" content="{{ site.url }}{{ image }}">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Public+Sans:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/assets/css/style.css">
  <script src="/assets/js/menu.js" defer></script>
</head>
<body>
<a class="skip" href="#contenu">Aller au contenu</a>
{% include "partials/header.njk" %}
<main id="contenu">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
</body>
</html>
