---
layout: base.njk
---
{%- from "partials/macros.njk" import photo -%}
<article>
  <header class="page-entete">
    <div class="conteneur conteneur--etroit">
      <a class="fil" href="/actualites/">← Actualités</a>
      <span class="actu__meta">{{ categorie }} · <time datetime="{{ page.date | isoDate }}">{{ page.date | dateFr }}</time></span>
      <h1>{{ titre }}</h1>
      {% if resume %}<p class="grand-texte">{{ resume }}</p>{% endif %}
    </div>
  </header>
  {% if image %}<div class="conteneur conteneur--etroit">{{ photo(image, image_alt, "", "page-photo") }}</div>{% endif %}
  <div class="conteneur conteneur--etroit prose">
    {{ content | safe }}
    {% if lien_externe %}<p><a class="bouton bouton--primaire" href="{{ lien_externe }}">Lire l'article complet →</a></p>{% endif %}
  </div>
</article>
